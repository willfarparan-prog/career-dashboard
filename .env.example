# Copy to .env.local for local development. Never commit real values.

# Neon Postgres (pooled connection string)
# DATABASE_URL=
# Neon Auth
# NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=      # 32+ random characters
# The only account allowed in (must also be email-verified)
# OWNER_EMAIL=you@example.com
# Public origin, e.g. https://career-dashboard.vercel.app
# NEXT_PUBLIC_APP_URL=

# Claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_DAILY_BUDGET_USD=5

# Discover: USAJOBS (federal jobs; free key from developer.usajobs.gov)
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=               # the email the key was issued to

# Local only: `next dev` without Neon or Claude
# CAREER_DEV_PREVIEW=1          # skip sign-in (dev server only)
# CAREER_LOCAL_DB=.local-db     # PGlite sandbox instead of Neon (run `pnpm db:local` first)
# AI_FAKE=1                     # canned Claude responses, no API spend (dev server and tests only)
