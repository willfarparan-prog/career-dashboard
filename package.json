{
  "name": "career-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Claude-powered resume and job-application workspace.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:local": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/auth-ui": "0.3.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
